{
  "nodes": [
    {
      "id": "time",
      "type": "time",
      "position": { "x": -1560, "y": 40 },
      "params": {}
    },
    {
      "id": "bounce",
      "type": "value/expression",
      "position": { "x": -1290, "y": 40 },
      "params": { "expression": "1 + abs(sin(time * 2)) * 3", "a": 0, "b": 0, "c": 0 }
    },
    {
      "id": "squashAmt",
      "type": "value/expression",
      "position": { "x": -1290, "y": 220 },
      "params": { "expression": "max(0, 1 - abs(sin(time * 2)))", "a": 0, "b": 0, "c": 0 }
    },
    {
